# ==============================================================================
# MarketLens - Environment Variables
# ==============================================================================
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# .env dosyasını ASLA git'e commit etmeyin.
# ==============================================================================


# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------

# Ortam: development, staging, production
ENVIRONMENT=development

# Debug mode (production'da false yapın)
DEBUG=true

# Backend URL (frontend'in backend'e ulaşacağı URL)
# Local development: http://localhost:8000
# Production: https://api.marketlens.yourdomain.com
BACKEND_URL=http://localhost:8000

# Frontend URL (CORS için backend'in bilmesi gereken)
# Local: http://localhost:5173
# Production: https://marketlens.yourdomain.com
FRONTEND_URL=http://localhost:5173

# Frontend → Backend URL (Vite tarafından kullanılır, VITE_ prefix gerekli)
# Local: http://localhost:8000
# Production: https://api.marketlens.yourdomain.com
VITE_API_URL=http://localhost:8000


# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------

POSTGRES_USER=marketlens
POSTGRES_PASSWORD=marketlens_dev_password_change_me
POSTGRES_DB=marketlens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Tam connection string (backend buradan okuyacak)
DATABASE_URL=postgresql+asyncpg://marketlens:marketlens_dev_password_change_me@postgres:5432/marketlens


# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery broker (genelde Redis ile aynı)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2


# ------------------------------------------------------------------------------
# JWT / Security
# ------------------------------------------------------------------------------

# JWT secret key - güçlü random bir string olmalı (en az 32 karakter)
# Üretmek için: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_random_64_char_hex_string_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Şifrelenmiş alanlar için (Anthropic API key gibi)
# openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_another_random_hex_string


# ------------------------------------------------------------------------------
# Binance API (Public — auth gerekmez)
# ------------------------------------------------------------------------------
# MarketLens sadece okuma yapar, kişisel API key gerekmez.
# Eğer rate limit'e takılırsanız kişisel key oluşturup ekleyebilirsiniz:

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Binance endpoint'leri
BINANCE_SPOT_URL=https://api.binance.com
BINANCE_FUTURES_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws


# ------------------------------------------------------------------------------
# CoinGecko (Faz 1)
# ------------------------------------------------------------------------------
# Ücretsiz tier yeterli. Pro key opsiyonel.

COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3


# ------------------------------------------------------------------------------
# Coinglass (Faz 2)
# ------------------------------------------------------------------------------
# https://www.coinglass.com/pricing — Hobbyist plan $29/ay
# Faz 2'ye geçince ekleyin.

COINGLASS_API_KEY=
COINGLASS_BASE_URL=https://open-api-v3.coinglass.com


# ------------------------------------------------------------------------------
# CryptoPanic (Faz 2)
# ------------------------------------------------------------------------------
# https://cryptopanic.com/developers/api/ — Free tier yeterli

CRYPTOPANIC_API_KEY=


# ------------------------------------------------------------------------------
# Etherscan (Faz 3)
# ------------------------------------------------------------------------------
# https://etherscan.io/apis — Ücretsiz

ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=


# ------------------------------------------------------------------------------
# Anthropic Claude API (Faz 4 - AI Assistant)
# ------------------------------------------------------------------------------
# https://console.anthropic.com — API key oluşturun
# Claude Sonnet 4 kullanılır (~$10/ay tipik kullanım)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514


# ------------------------------------------------------------------------------
# Telegram Bot
# ------------------------------------------------------------------------------
# 1. Telegram'da @BotFather'a /newbot mesajı gönderin
# 2. Bot oluşturun, token alın
# 3. Buraya yapıştırın
# 4. Bot'u kendi hesabınızla başlatın (/start)
# 5. https://api.telegram.org/bot<TOKEN>/getUpdates URL'sinden chat_id alın

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=


# ------------------------------------------------------------------------------
# Sentry (Production error tracking)
# ------------------------------------------------------------------------------
# Opsiyonel ama production için önerilir
# https://sentry.io — ücretsiz tier var

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1


# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FORMAT=json


# ------------------------------------------------------------------------------
# Cache TTL'leri (saniye)
# ------------------------------------------------------------------------------

CACHE_TTL_KLINE_1M=30
CACHE_TTL_KLINE_5M=120
CACHE_TTL_KLINE_15M=60
CACHE_TTL_KLINE_1H=600
CACHE_TTL_KLINE_4H=1800
CACHE_TTL_KLINE_1D=3600
CACHE_TTL_FUNDING=60
CACHE_TTL_OI=60
CACHE_TTL_ORDERBOOK=5
CACHE_TTL_FEAR_GREED=3600
CACHE_TTL_MACRO=300
CACHE_TTL_LIQUIDATION=30
CACHE_TTL_NEWS=300
CACHE_TTL_CALENDAR=43200


# ------------------------------------------------------------------------------
# Scanner Defaults
# ------------------------------------------------------------------------------

SCANNER_DEFAULT_INTERVAL_MINUTES=15
SCANNER_MAX_PARALLEL=3
SCANNER_DEFAULT_MIN_QUALITY=B


# ------------------------------------------------------------------------------
# Risk Defaults
# ------------------------------------------------------------------------------

DEFAULT_ACCOUNT_BALANCE=3000
DEFAULT_RISK_PER_TRADE_PCT=2.0
DEFAULT_MAX_LEVERAGE=10
DEFAULT_DAILY_MAX_TRADES=5
DEFAULT_DAILY_MAX_RISK_PCT=4.0
DEFAULT_AUTO_PAUSE_AFTER_LOSSES=3
DEFAULT_RISK_AFTER_2_LOSSES_PCT=1.5
DEFAULT_RISK_AFTER_3_LOSSES_PCT=1.0


# ------------------------------------------------------------------------------
# Rate Limiting (per minute)
# ------------------------------------------------------------------------------

RATE_LIMIT_AUTH=5
RATE_LIMIT_ANALYSIS=30
RATE_LIMIT_SCANNER_MANUAL=5
RATE_LIMIT_AI_CHAT=20
RATE_LIMIT_DEFAULT=60


# ------------------------------------------------------------------------------
# Webhook (opsiyonel - bir sonraki sürümde aktive edilebilir)
# ------------------------------------------------------------------------------

# WEBHOOK_INCOMING_SECRET=
# WEBHOOK_OUTGOING_URLS=


# ==============================================================================
# Production-only settings
# ==============================================================================
# Aşağıdakiler sadece production'da gerekli

# SSL/TLS
# SSL_CERT_PATH=/etc/ssl/certs/marketlens.crt
# SSL_KEY_PATH=/etc/ssl/private/marketlens.key

# Domain
# DOMAIN=marketlens.yourdomain.com

# DigitalOcean Spaces (backup için)
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=marketlens-backups
# DO_SPACES_REGION=fra1
